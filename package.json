{
  "name": "codex-loop",
  "version": "0.1.0",
  "private": true,
  "description": "Write an engineering standard once. Enforce it in CI, teach it to coding agents, and see how it is doing.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p action/tsconfig.json",
    "test": "node --import tsx --test \"packages/**/test/*.test.ts\" \"apps/**/*.test.ts\" \"action/**/*.test.ts\"",
    "build:cli": "node scripts/build-cli.mjs",
    "build:action": "node scripts/build-action.mjs",
    "build": "npm run build:cli && npm run build:action",
    "compat": "tsx scripts/compat.ts",
    "check": "npm run typecheck && npm test",
    "docs": "tsx scripts/gen-controls-doc.mts",
    "compat:diff": "tsx scripts/diff-local-vs-remote.mts",
    "smoke": "node scripts/smoke.mjs",
    "mock:github": "node scripts/mock-github.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
